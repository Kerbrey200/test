  "version": "1.0.0",
  "description": "Tri-Core Autonomous Evolution Engine: Karpathy Ratchet + MUSE Memory + AutoSkill Distiller",
  "type": "module",
  "main": "core/index.js",
  "bin": {
    "evocore": "./bin/evocore.js",
    "evocore-ui": "./bin/serve.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
